# OpenDispatch environment
# Copy to .env and fill in real values. All Supabase-related variables are
# required for the application to boot and authenticate users.

# ---- Database (Supabase Postgres) ----
# Get this from Supabase Dashboard > Project Settings > Database > Connection
# string > Direct. The user portion of the URL is "postgres" and the password
# is the one you set when you created the project.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.ythiuyltgzerhsnkrsbt.supabase.co:5432/postgres

# ---- Supabase Auth ----
# Project Settings > API > Project URL
SUPABASE_URL=https://ythiuyltgzerhsnkrsbt.supabase.co
# Project Settings > API > Project API keys > anon public (safe for browser)
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
# Project Settings > API > Project API keys > service_role (server-only secret)
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
# Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]
# Set to true to make `make seed` create the default user via auth.admin.
SEED_USE_SUPABASE_AUTH=true

# ---- Redis (local container) ----
REDIS_URL=redis://redis:6379/0

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:5173
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- Storage ----
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/var/opendispatch/storage

# ---- Frontend ----
VITE_API_BASE=http://localhost:8000/api/v1
# These two are read by the web app at build time. The values are duplicated
# into the compose file so docker-compose passes them through automatically.
VITE_SUPABASE_URL=https://ythiuyltgzerhsnkrsbt.supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Seed user (created by `make seed` when SEED_USE_SUPABASE_AUTH=true) ----
SEED_USER_EMAIL=dispatch@opendispatch.example.com
SEED_USER_PASSWORD=dispatch123!
SEED_USER_NAME=Dispatch Operator

# ---- App ----
APP_ENV=production
