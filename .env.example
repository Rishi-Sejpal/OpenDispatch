# OpenDispatch environment
# Copy to .env and adjust as needed

# Postgres
POSTGRES_USER=opendispatch
POSTGRES_PASSWORD=opendispatch
POSTGRES_DB=opendispatch
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://opendispatch:opendispatch@db:5432/opendispatch

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:5173
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/var/opendispatch/storage

# Frontend
VITE_API_BASE=http://localhost:8000/api/v1

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Seed user (created by `make seed`)
SEED_USER_EMAIL=dispatch@opendispatch.example.com
SEED_USER_PASSWORD=dispatch123!
SEED_USER_NAME=Dispatch Operator

# App
APP_ENV=development
